# ── Dependencies (reinstalled via npm ci inside the container) ──
node_modules
backend/node_modules
contracts/node_modules

# ── Version control ──
.git
.gitignore

# ── IDE / editor config ──
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# ── CI / GitHub ──
.github

# ── Documentation (not needed at runtime) ──
*.md
!README.md

# ── Environment / secrets (must never be baked into layers) ──
.env
.env.*
!.env.example
backend/.env
backend/.env.*
contracts/.env
contracts/.env.*
*.pem
*.key
credentials.json
secrets.json

# ── Solidity / Hardhat (not needed by API or frontend) ──
contracts/cache
contracts/artifacts
contracts/typechain-types
contracts

# ── Build artifacts (rebuilt inside the container) ──
dist
dist-ssr
backend/dist

# ── Logs ──
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Uploads (runtime-generated) ──
uploads/

# ── Docker files (prevent recursive context) ──
Dockerfile
docker-compose.yml
nginx

# ── Agents / Gemini ──
.agents
.gemini
