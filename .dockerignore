# ── Dependencies (reinstalled via npm ci inside the container) ──
node_modules
backend/node_modules
contracts/node_modules

# ── Version control ──
.git
.gitignore

# ── IDE / editor config ──
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# ── CI / GitHub ──
.github

# ── Documentation (not needed at runtime) ──
*.md
!README.md

# ── Environment / secrets (must never be baked into images) ──
.env
.env.*
!.env.example
!.env.docker
backend/.env
backend/.env.*
contracts/.env
contracts/.env.*
*.pem
*.key
credentials.json
secrets.json

# ── Solidity / Hardhat build caches ──
contracts/cache
contracts/artifacts
contracts/typechain-types

# ── Build artifacts (rebuilt inside the container) ──
dist
dist-ssr
backend/dist

# ── Logs & test reports ──
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
slither-report.json

# ── Uploads (runtime-generated) ──
uploads/

# ── Agents / Gemini ──
.agents
.gemini
