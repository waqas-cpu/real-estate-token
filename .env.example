# ============================================================
# RWA Real Estate Tokenization Platform — Environment Variables
# SECURITY NOTICE: Never commit real secrets or private keys to git!
# In production, inject these via HashiCorp Vault, AWS Secrets Manager,
# or Kubernetes Secrets.
# ============================================================

# ── General Server Configuration ──────────────────────────────
NODE_ENV=production
PORT=8080
CORS_ORIGIN=http://localhost:8080
LOG_REQUESTS=false

# ── PostgreSQL Database (Container or Managed RDS/Cloud SQL) ──
POSTGRES_DB=rwa_platform
POSTGRES_USER=rwa_user
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://rwa_user:replace_with_strong_database_password@postgres:5432/rwa_platform

# ── Redis Cache & Queue ───────────────────────────────────────
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/0

# ── Supabase (Optional managed DB / Auth / Storage) ───────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Blockchain & RPC Configuration ────────────────────────────
RWA_NETWORK_PROFILE=testnet
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id
VITE_ETHEREUM_RPC=https://sepolia.infura.io/v3/your_infura_project_id
CHAIN_DEPLOYMENT_FILE=./deployments/sepolia.json

# ── Blockchain Role Keys (Secrets Manager Injected Only) ───────
# NEVER STORE PLAINTEXT PRIVATE KEYS IN DOCKER IMAGES
DEPLOYER_PRIVATE_KEY=
TREASURY_MULTISIG_ADDRESS=
EMERGENCY_OPERATOR_ADDRESS=
COMPLIANCE_AGENT_ADDRESS=
ORACLE_SIGNER_ADDRESS=

# ── Platform Token Economics & Guardrails ─────────────────────
ALLOW_SMART_CONTRACT_DEPLOY=false
ALLOW_TOKEN_ECONOMICS_APPLY=true
ALLOW_MAINNET_DEPLOY=false

# ── IPFS & Document Notarization ──────────────────────────────
IPFS_GATEWAY=https://gateway.pinata.cloud
PINATA_API_KEY=your_pinata_api_key
PINATA_JWT=your_pinata_jwt_token

# ── External Oracle Feeds (Chainlink, Pyth) ───────────────────
CHAINLINK_API_KEY=
PYTH_API_KEY=
HM_LAND_REGISTRY_URL=
ACCREDITATION_REGISTRY_URL=

# ── KYC / KYB Integration (Sumsub) ────────────────────────────
SUMSUB_APP_TOKEN=your_sumsub_app_token
SUMSUB_WEBHOOK_SECRET=your_sumsub_webhook_secret

# ── Observability & Error Tracking ────────────────────────────
SENTRY_DSN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
