# ============================================================
# RWA Real Estate Token — Dedicated Background Worker Dockerfile
# Executes monitoring sweeps, compliance checks, and audit batching
# ============================================================

FROM node:22-alpine AS deps

RUN apk add --no-cache dumb-init

WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine AS runner

COPY --from=deps /usr/bin/dumb-init /usr/bin/dumb-init

RUN addgroup -S rwa && adduser -S rwa -G rwa

WORKDIR /app

COPY --from=deps /app/backend/node_modules ./backend/node_modules
COPY backend/package.json ./backend/
COPY backend/src ./backend/src
COPY src/lib ./src/lib
COPY supabase/migrations ./supabase/migrations

RUN chown -R rwa:rwa /app

USER rwa

WORKDIR /app/backend

ENV NODE_ENV=production

ENTRYPOINT ["dumb-init", "--"]
CMD ["npx", "tsx", "src/worker.ts"]
